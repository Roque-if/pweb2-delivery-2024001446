<div class="cabecalho">
  <h1>Entregas</h1>
  <a class="botao" href="/entregas/nova">Nova Entrega</a>
</div>

<form class="filtro" method="get" action="/entregas">
  <label for="status">Filtrar por status</label>
  <select name="status" id="status">
    <option value="">Todos</option>
    <% statusDisponiveis.forEach((s) => { %>
      <option value="<%= s %>" <%= filtro === s ? 'selected' : '' %>><%= s %></option>
    <% }) %>
  </select>
  <button type="submit">Filtrar</button>
</form>

<table>
  <thead>
    <tr>
      <th>#</th>
      <th>Descrição</th>
      <th>Origem</th>
      <th>Destino</th>
      <th>Status</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% if (entregas.length === 0) { %>
      <tr><td colspan="6" class="vazio">Nenhuma entrega encontrada.</td></tr>
    <% } %>
    <% entregas.forEach((entrega) => { %>
      <tr>
        <td><%= entrega.id %></td>
        <td><%= entrega.descricao %></td>
        <td><%= entrega.origem %></td>
        <td><%= entrega.destino %></td>
        <td><span class="badge badge-<%= entrega.status %>"><%= entrega.status %></span></td>
        <td><a href="/entregas/<%= entrega.id %>">Detalhes</a></td>
      </tr>
    <% }) %>
  </tbody>
</table>
