<div class="cabecalho">
  <h1>Entrega #<%= entrega.id %></h1>
  <span class="badge badge-<%= entrega.status %>"><%= entrega.status %></span>
</div>

<dl class="detalhes">
  <dt>Descrição</dt>
  <dd><%= entrega.descricao %></dd>
  <dt>Origem</dt>
  <dd><%= entrega.origem %></dd>
  <dt>Destino</dt>
  <dd><%= entrega.destino %></dd>
  <dt>Motorista</dt>
  <dd><%= motorista ? motorista.nome + ' (' + motorista.cpf + ')' : 'Nenhum motorista atribuído' %></dd>
</dl>

<div class="acoes-estado">
  <% if (entrega.status === 'CRIADA' || entrega.status === 'EM_TRANSITO') { %>
    <form method="post" action="/entregas/<%= entrega.id %>/avancar?_method=PATCH">
      <button type="submit">Avançar status</button>
    </form>
  <% } %>

  <% if (entrega.status !== 'ENTREGUE' && entrega.status !== 'CANCELADA') { %>
    <form method="post" action="/entregas/<%= entrega.id %>/cancelar?_method=PATCH" onsubmit="return confirm('Cancelar esta entrega?')">
      <button type="submit" class="perigo">Cancelar entrega</button>
    </form>
  <% } %>
</div>

<% if (entrega.status === 'CRIADA') { %>
  <form class="atribuir" method="post" action="/entregas/<%= entrega.id %>/atribuir?_method=PATCH">
    <label for="motoristaId">Atribuir motorista</label>
    <select name="motoristaId" id="motoristaId">
      <option value="">Selecione...</option>
      <% motoristasAtivos.forEach((m) => { %>
        <option value="<%= m.id %>" <%= m.id === entrega.motoristaId ? 'selected' : '' %>><%= m.nome %></option>
      <% }) %>
    </select>
    <button type="submit">Atribuir</button>
  </form>
<% } %>

<h2>Histórico</h2>
<ol class="historico">
  <% entrega.historico.forEach((evento) => { %>
    <li>
      <time datetime="<%= evento.data %>"><%= new Date(evento.data).toLocaleString('pt-BR') %></time>
      <span><%= evento.descricao %></span>
    </li>
  <% }) %>
</ol>

<p><a href="/entregas">&larr; Voltar para a lista</a></p>
