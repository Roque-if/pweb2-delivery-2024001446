<h1>Nova Entrega</h1>

<%- include('../partials/erros-form') %>

<form class="formulario" method="post" action="/entregas">
  <label for="descricao">Descrição</label>
  <input type="text" id="descricao" name="descricao" value="<%= valores.descricao || '' %>">

  <label for="origem">Origem</label>
  <input type="text" id="origem" name="origem" value="<%= valores.origem || '' %>">

  <label for="destino">Destino</label>
  <input type="text" id="destino" name="destino" value="<%= valores.destino || '' %>">

  <div class="acoes">
    <button type="submit">Criar entrega</button>
    <a href="/entregas">Voltar</a>
  </div>
</form>
